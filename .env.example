# Copy to .env.local and fill in. Every variable here is NEXT_PUBLIC_, which
# is not a convention but a statement of fact: next.config.mjs sets
# output: "export", so this site has no server and every value below is
# downloaded and readable by every visitor.
#
# The Supabase secret key, the service_role JWT and the database password
# have NO home in this repository. There is nowhere to put them that a
# visitor could not read. What protects the data is row level security in
# the database. See supabase/schema.sql.

# Project API origin, from Settings, API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The publishable key. Public by design. Not the secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Absolute origin this build is served from. Sent as redirect_to on sign-in,
# so it must also be on the allow list under Authentication, URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
